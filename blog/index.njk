---
layout: false
permalink: /blog/index.html
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Articles on product engineering, hardware identity, and building digital products — by Nikhilesh Wani." />
    <title>Blog — Nikhilesh Wani</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/site.css" />
  </head>
  <body>
    <header class="nav shell">
      <a href="/index.html" class="brand">
        <span class="brand-first">Nikhilesh</span>
        <span class="brand-last">Wani</span>
      </a>
      <nav>
        <a href="/portfolio.html">Portfolio</a>
        <a href="/services.html">Services</a>
        <a href="/blog/">Blog</a>
        <a href="/index.html#about">About</a>
      </nav>
      <a class="nav-cta" href="/contact.html">Let's talk ↗</a>
    </header>

    <main>
      <section class="page-header">
        <div class="shell">
          <a class="crumb" href="/index.html">← Back home</a>
          <div class="title-block">
            <h1>Thoughts &<br /><em>writing.</em></h1>
            <p>On product engineering, hardware identity, and the craft of building things that work.</p>
          </div>
        </div>
      </section>

      <section class="section shell">
        <div class="blog-grid">
          {% for post in collections.posts %}
          <article class="blog-card">
            <a href="{{ post.url }}">
              <div class="blog-card-meta">
                <small>{{ post.date | readableDate }} · {{ post.templateContent | readingTime }}</small>
              </div>
              <h3>{{ post.data.title }}</h3>
              <p>{{ post.data.description }}</p>
              {% if post.data.tags | length %}
              <div class="tags">
                {% for tag in post.data.tags %}
                <span>{{ tag }}</span>
                {% endfor %}
              </div>
              {% endif %}
            </a>
          </article>
          {% endfor %}

          {% if collections.posts.length == 0 %}
          <p style="color: var(--muted); font-size: 15px;">No posts yet — check back soon.</p>
          {% endif %}
        </div>
      </section>

      <section class="contact shell fade-in">
        <p class="eyebrow">Start a conversation</p>
        <h2>Have an idea<br />worth <em>making?</em></h2>
        <p>Let's build something clear, useful, and built to last.</p>
        <a class="button lime" href="/contact.html">Get in touch <span>→</span></a>
      </section>
    </main>

    <footer class="footer shell">
      <a href="/index.html" class="brand">
        <span class="brand-first">Nikhilesh</span>
        <span class="brand-last">Wani</span>
      </a>
      <p>© <span id="year"></span> Nikhilesh Wani. <span style="opacity:.5">v2.1.0</span></p>
      <a href="#top">Back to top ↑</a>
    </footer>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="/script.js"></script>
  </body>
</html>
